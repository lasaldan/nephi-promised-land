; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="The Promised Land"
config/name_localized={
"es": "Bountiful: Nefi construye un barco"
}
config/description="A gentle scripture adventure for kids in the promised land."
config/version="1.0.0"
run/main_scene="res://menus/splash.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/show_image=false
boot_splash/image="uid://70nolwahrj2h"
config/icon="uid://dtijp5a1i3gll"

[autoload]

SignalBus="*res://core/signal_bus.gd"
StoryState="*res://core/story_state.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
RenderClock="*res://core/render_clock.gd"
ScreenShape="*res://core/screen_shape.gd"
Screenshot="*res://core/screenshot.gd"

[dialogue_manager]

runtime/balloon_path="res://story/balloon/balloon.tscn"

[display]

window/size/viewport_width=512
window/size/viewport_height=288
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=4
mouse_cursor/custom_image="uid://ce1di4fyr2427"
mouse_cursor/custom_image_hotspot=Vector2(7, 1)
mouse_cursor/tooltip_position_offset=Vector2(15, 15)

[editor_plugins]

enabled=PackedStringArray("res://addons/chapter_picker/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/tile_cursor/plugin.cfg")

