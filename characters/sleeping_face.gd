class_name SleepingFace

# One frame of a Universal LPC sheet with the eyes closed, built at runtime so
# the sheets themselves never need editing (they are regenerated by CharGen).
# Used by the sleep pose (npc.gd), which shows the south-facing stand frame
# turned on its side. The drop shadow under their feet is left out too: the
# only part of a frame that is not fully opaque, and it would lie beside them.
#
# LPC eyes facing south are two 4x3 boxes, mirror images of each other:
#   row 0  lashes: two dark pixels in the middle, maybe a highlight at a corner
#   row 1  white, iris, white
#   row 2  lower iris in the middle, white at the inner corner
# Adults have them at rows 29-31 of the frame, children lower, and the gap
# between the eyes differs by a pixel. So they are found, not assumed: the
# first row where a dark lash pair sits over something bright and the two
# boxes mostly mirror each other.
#
# Closing them paints the eye colours with the skin between the eyes and draws
# the lashes across the middle row. Only colours that match in both eyes are
# painted, so hair falling over one eye is left alone.

const FRAME := 64
const LEFT_EYE_X := 26

static var _cache := {}


# The frame (column, row) of sheet as its own texture, eyes closed. Cached per
# sheet and frame. If no eyes are found, they are left open.
# With eyes_open, the same frame without the shadow but awake, for someone
# lying down who is not asleep (the "lie" pose).
static func frame(sheet: Texture2D, coords: Vector2i, eyes_open := false) -> Texture2D:
	var key := "%d:%d:%d:%s" % [sheet.get_instance_id(), coords.x, coords.y, eyes_open]
	if _cache.has(key):
		return _cache[key]
	var image := sheet.get_image()
	if image == null:
		return null
	if image.is_compressed():
		image.decompress()
	image = image.get_region(Rect2i(coords * FRAME, Vector2i(FRAME, FRAME)))
	image.convert(Image.FORMAT_RGBA8)
	_drop_shadow(image)
	if not eyes_open:
		_close_eyes(image)
	var texture := ImageTexture.create_from_image(image)
	_cache[key] = texture
	return texture


static func _drop_shadow(image: Image) -> void:
	for y in FRAME:
		for x in FRAME:
			if image.get_pixel(x, y).a < 1.0:
				image.set_pixel(x, y, Color.TRANSPARENT)


static func _close_eyes(image: Image) -> void:
	var eyes := _find_eyes(image)
	if eyes == Vector2i(-1, -1):
		return
	var top := eyes.x
	var right_x := eyes.y
	var mirror := func(x: int) -> int: return right_x + 3 - (x - LEFT_EYE_X)

	var skin := _most_common(image, Rect2i(LEFT_EYE_X + 4, top + 1, right_x - LEFT_EYE_X - 4, 2))
	var lash := _rgba(image, 27, top)

	# Eye pixels of the left eye, by position. The outer corners of the lash
	# row are only eye when they are a highlight; otherwise they are the face.
	var core: Array[Vector2i] = []
	for x in [26, 29]:
		if _luma(image.get_pixel(x, top)) > 0.55:
			core.append(Vector2i(x, top))
	core.append_array([Vector2i(27, top), Vector2i(28, top)])
	for x in range(26, 30):
		core.append(Vector2i(x, top + 1))
	core.append_array([Vector2i(27, top + 2), Vector2i(28, top + 2), Vector2i(29, top + 2)])

	# The eye's colours: what both eyes agree on.
	var palette := {}
	for p in core:
		var c := _rgba(image, p.x, p.y)
		if c == _rgba(image, mirror.call(p.x), p.y) and c != skin:
			palette[c] = true

	var skin_color := Color.hex(skin)
	var lash_color := Color.hex(lash)
	for side in 2:
		var lid_open := false
		for p in core:
			var x: int = p.x if side == 0 else mirror.call(p.x)
			if palette.has(_rgba(image, x, p.y)):
				image.set_pixel(x, p.y, skin_color)
				lid_open = true
		if not lid_open:
			continue
		for x in [27, 28]:
			var lx: int = x if side == 0 else mirror.call(x)
			image.set_pixel(lx, top + 1, lash_color)


# (top row, x of the right eye's box), or (-1, -1).
static func _find_eyes(image: Image) -> Vector2i:
	var best := Vector2i(-1, -1)
	var best_score := 5
	for top in range(16, 46):
		var ok := true
		for p in [Vector2i(27, top), Vector2i(28, top), Vector2i(27, top + 2), Vector2i(28, top + 2)]:
			if image.get_pixel(p.x, p.y).a < 0.5:
				ok = false
		if not ok:
			continue
		if _rgba(image, 27, top) != _rgba(image, 28, top) or _rgba(image, 27, top + 2) != _rgba(image, 28, top + 2):
			continue
		var lash := _luma(image.get_pixel(27, top))
		if lash > 0.3:
			continue
		var white := maxf(_luma(image.get_pixel(26, top + 1)), _luma(image.get_pixel(29, top + 1)))
		if white < 0.55 or white - lash < 0.3:
			continue
		for right_x in [33, 34]:
			var score := 0
			for dy in 3:
				for x in range(26, 30):
					var mx: int = right_x + 3 - (x - LEFT_EYE_X)
					if image.get_pixel(x, top + dy).a > 0.5 and _rgba(image, x, top + dy) == _rgba(image, mx, top + dy):
						score += 1
			if score >= 9:
				return Vector2i(top, right_x)
			if score > best_score:
				best_score = score
				best = Vector2i(top, right_x)
	return best


static func _rgba(image: Image, x: int, y: int) -> int:
	return image.get_pixel(x, y).to_rgba32()


static func _luma(c: Color) -> float:
	return 0.299 * c.r + 0.587 * c.g + 0.114 * c.b


static func _most_common(image: Image, area: Rect2i) -> int:
	var counts := {}
	for y in range(area.position.y, area.end.y):
		for x in range(area.position.x, area.end.x):
			var c := _rgba(image, x, y)
			counts[c] = counts.get(c, 0) + 1
	var best := 0
	var most := 0
	for c in counts:
		if counts[c] > most:
			most = counts[c]
			best = c
	return best
