[gd_scene format=3]

[ext_resource type="Script" path="res://menus/splash.gd" id="1_script"]
[ext_resource type="Theme" path="res://ui/menu_theme.tres" id="2_theme"]
[ext_resource type="Texture2D" path="res://ui/danimate_logo.png" id="3_logo"]

[node name="Splash" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Black" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 1)

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 10
alignment = 1

[node name="Byline" type="Label" parent="Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.85, 0.85, 1)
theme_override_font_sizes/font_size = 14
text = "An interactive story by"
horizontal_alignment = 1

[node name="Brand" type="VBoxContainer" parent="Content"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = -18

[node name="Logo" type="TextureRect" parent="Content/Brand"]
texture_filter = 4
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
texture = ExtResource("3_logo")
expand_mode = 1
stretch_mode = 5

[node name="Name" type="Label" parent="Content/Brand"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 24
text = "Danimate"
horizontal_alignment = 1
