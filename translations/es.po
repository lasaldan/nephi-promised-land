#. sheep in ~ talk_sheep
#: story/main.dialogue:8
msgctxt "BAA_AA_AA_I_THE_SHEEP_KEEPS_CH_495A30"
msgid "Baa-aa-aa! [i](The sheep keeps chewing and stares at you.)[/i]"
msgstr "¡Beee-ee-ee! [i](La oveja sigue masticando y se te queda mirando.)[/i]"

#. chicken in ~ talk_chicken
#: story/main.dialogue:12
msgctxt "BAWK_BAWK_BAWK_BAWK_I_SHE_SEEM_1B9313"
msgid "Bawk! Bawk, bawk... BAWK! [i](She seems to have a lot to say.)[/i]"
msgstr "¡Coc! Coc, coc... ¡COCOCÓ! [i](Parece que tiene mucho que decir.)[/i]"

#. goat in ~ talk_goat
#: story/main.dialogue:16
msgctxt "MAAA_I_THE_GOAT_TRIES_TO_NIBBL_57AA79"
msgid "Maaa! [i](The goat tries to nibble your sleeve.)[/i]"
msgstr "¡Meee! [i](La cabra intenta mordisquearte la manga.)[/i]"

#. the name over sheep's lines
#: characters/cast.gd
msgctxt "dialogue"
msgid "Sheep"
msgstr "Oveja"

#. the name over chicken's lines
#: characters/cast.gd
msgctxt "dialogue"
msgid "Chicken"
msgstr "Gallina"

#. the name over goat's lines
#: characters/cast.gd
msgctxt "dialogue"
msgid "Goat"
msgstr "Cabra"

#. Nephi in the controls tour
#: story/text/tour_lines.gd:10
msgctxt "tour_walk_touch"
msgid "Drag here to help me walk around. "
msgstr "Arrastra aquí para ayudarme a caminar."

#. Nephi in the controls tour
#: story/text/tour_lines.gd:11
msgctxt "tour_walk_desktop"
msgid "Use the WASD keys to help me walk around."
msgstr "Usa las teclas WASD para ayudarme a caminar."

#. Nephi in the controls tour
#: story/text/tour_lines.gd:12
msgctxt "tour_use_touch"
msgid "When I'm close to something, tap here to pick it up, or to talk to someone."
msgstr "Cuando esté cerca de algo, toca aquí para recogerlo o para hablar con alguien."

#. Nephi in the controls tour
#: story/text/tour_lines.gd:13
msgctxt "tour_use_desktop"
msgid "When I'm close to something, press Space, or click here, to pick it up or talk to someone."
msgstr "Cuando esté cerca de algo, presiona Espacio, o haz clic aquí, para recogerlo o hablar con alguien."

#. Nephi in the controls tour
#: story/text/tour_lines.gd:14
msgctxt "tour_quest_touch"
msgid "This tells us what to do next. Tap it to hear it."
msgstr "Esto nos dice qué hacer después. Tócalo para escucharlo."

#. Nephi in the controls tour
#: story/text/tour_lines.gd:15
msgctxt "tour_quest_desktop"
msgid "This tells us what to do next. Click it to hear it."
msgstr "Esto nos dice qué hacer después. Haz clic para escucharlo."

#. Nephi in the controls tour
#: story/text/tour_lines.gd:16
msgctxt "tour_pray_touch"
msgid "Not sure where to go? Tap here, and I'll pray to know the way."
msgstr "¿No sabes adónde ir? Toca aquí y oraré para saber el camino."

#. Nephi in the controls tour
#: story/text/tour_lines.gd:17
msgctxt "tour_pray_desktop"
msgid "Not sure where to go? Click here, and I'll pray to know the way."
msgstr "¿No sabes adónde ir? Haz clic aquí y oraré para saber el camino."

#. Nephi in the controls tour
#: story/text/tour_lines.gd:18
msgctxt "tour_backpack"
msgid "Things we pick up go here, in my backpack. Now, let's go!"
msgstr "Lo que recogemos va aquí, en mi mochila. ¡Ahora, vamos!"

#. name of pray_oft
#: story/achievements.gd:29
msgctxt "achievement"
msgid "Pray Oft"
msgstr "Ora a menudo"

#. description of pray_oft
#: story/achievements.gd:29
msgctxt "achievement"
msgid "Pray ten times."
msgstr "Ora diez veces."

#. name of dolittle
#: story/achievements.gd:30
msgctxt "achievement"
msgid "Dolittle"
msgstr "Doctor Dolittle"

#. description of dolittle
#: story/achievements.gd:30
msgctxt "achievement"
msgid "Talk with a sheep, a chicken, and a goat."
msgstr "Habla con una oveja, una gallina y una cabra."

#. name of small_talk
#: story/achievements.gd:32
msgctxt "achievement"
msgid "Small Talk"
msgstr "De charla"

#. description of small_talk
#: story/achievements.gd:32
msgctxt "achievement"
msgid "Talk with everyone."
msgstr "Habla con todos."

#. name of lepidopterist
#: story/achievements.gd:33
msgctxt "achievement"
msgid "Lepidopterist"
msgstr "Lepidopterólogo"

#. description of lepidopterist
#: story/achievements.gd:33
msgctxt "achievement"
msgid "Reach out to a butterfly."
msgstr "Acércate a una mariposa."

#. name of snuggle_bunny
#: story/achievements.gd:35
msgctxt "achievement"
msgid "Snuggle Bunny"
msgstr "Conejito mimoso"

#. description of snuggle_bunny
#: story/achievements.gd:35
msgctxt "achievement"
msgid "Reach out to a wild bunny."
msgstr "Acércate a un conejo silvestre."

